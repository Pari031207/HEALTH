            <remote-type>129</remote-type>
            <local-name>[Disease]</local-name>
            <parent-name>[cleaned_patients_data.csv]</parent-name>
            <remote-alias>Disease</remote-alias>
            <ordinal>13</ordinal>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <width>1073741823</width>
            <contains-null>true</contains-null>
            <collation flag='0' name='LEN_RUS' />
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>AgeGroup</remote-name>
            <remote-type>129</remote-type>
            <local-name>[AgeGroup]</local-name>
            <parent-name>[cleaned_patients_data.csv]</parent-name>
            <remote-alias>AgeGroup</remote-alias>
            <ordinal>14</ordinal>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
