      </connection>
      <aliases enabled='yes' />
      <column caption='High Risk Flag Num' datatype='integer' name='[Calculation_HighRisk_Num]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([HighRisk] = &quot;Yes&quot;, 1, 0)' />
      </column>
      <column caption='Disease Flag Num' datatype='integer' name='[Calculation_Disease_Num]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Disease] != &quot;None&quot;, 1, 0)' />
      </column>
      <column caption='High Risk %' datatype='real' default-format='p0.0%' name='[Calculation_HighRisk_Pct]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_HighRisk_Num]) / COUNT([PatientID])' />
      </column>
      <column caption='Disease Prevalence %' datatype='real' default-format='p0.0%' name='[Calculation_Disease_Pct]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_Disease_Num]) / COUNT([PatientID])' />
      </column>
      <column datatype='string' name='[PatientID]' role='dimension' type='nominal' />
      <column datatype='string' name='[Disease]' role='dimension' type='nominal' />
      <column datatype='string' name='[AgeGroup]' role='dimension' type='nominal' />
      <column datatype='string' name='[BMICategory]' role='dimension' type='nominal' />
      <column datatype='string' name='[HighRisk]' role='dimension' type='nominal' />
      <column datatype='real' name='[BMI]' role='measure' type='quantitative' />
      <column datatype='integer' name='[BloodPressure]' role='measure' type='quantitative' />
      <column datatype='integer' name='[Cholesterol]' role='measure' type='quantitative' />
      <column datatype='integer' name='[Glucose]' role='measure' type='quantitative' />
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='KPI_Summary'>
      <table>
        <view>
          <datasources>
            <datasource caption='cleaned_patients_data' name='federated.patients' />
          </datasources>
          <datasource-dependencies datasource='federated.patients'>
            <column datatype='string' name='[PatientID]' role='dimension' type='nominal' />
            <column datatype='real' name='[Calculation_HighRisk_Pct]' role='measure' type='quantitative' />
            <column datatype='real' name='[Calculation_Disease_Pct]' role='measure' type='quantitative' />
            <column datatype='real' name='[BMI]' role='measure' type='quantitative' />
            <column datatype='integer' name='[BloodPressure]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
      <simple-id uuid='worksheet-kpi-1' />
    </worksheet>
    <worksheet name='Prevalence_by_AgeGroup'>
      <table>
        <view>
          <datasources>
            <datasource caption='cleaned_patients_data' name='federated.patients' />
          </datasources>
          <datasource-dependencies datasource='federated.patients'>
            <column datatype='string' name='[AgeGroup]' role='dimension' type='nominal' />
            <column datatype='string' name='[Disease]' role='dimension' type='nominal' />
            <column datatype='string' name='[PatientID]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
          </pane>
        </panes>
        <rows>[federated.patients].[none:AgeGroup:nk]</rows>
        <cols>[federated.patients].[cnt:PatientID:qk]</cols>
      </table>
      <simple-id uuid='worksheet-prev-age' />
    </worksheet>
    <worksheet name='Prevalence_by_BMICategory'>
      <table>
        <view>
          <datasources>
            <datasource caption='cleaned_patients_data' name='federated.patients' />
          </datasources>
          <datasource-dependencies datasource='federated.patients'>
            <column datatype='string' name='[BMICategory]' role='dimension' type='nominal' />
            <column datatype='string' name='[Disease]' role='dimension' type='nominal' />
            <column datatype='string' name='[PatientID]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
          </pane>
        </panes>
        <rows>[federated.patients].[none:BMICategory:nk]</rows>
        <cols>[federated.patients].[cnt:PatientID:qk]</cols>
      </table>
      <simple-id uuid='worksheet-prev-bmi' />
    </worksheet>
    <worksheet name='Risk_Factor_Heatmap'>
      <table>
        <view>
          <datasources>
            <datasource caption='cleaned_patients_data' name='federated.patients' />
          </datasources>
          <datasource-dependencies datasource='federated.patients'>
            <column datatype='string' name='[Disease]' role='dimension' type='nominal' />
            <column datatype='integer' name='[BloodPressure]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Cholesterol]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Glucose]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Square' />
          </pane>
        </panes>
        <rows>[federated.patients].[none:Disease:nk]</rows>
        <cols />
      </table>
      <simple-id uuid='worksheet-rf-heatmap' />
    </worksheet>
    <worksheet name='Lifestyle_vs_Disease'>
      <table>
        <view>
          <datasources>
            <datasource caption='cleaned_patients_data' name='federated.patients' />
          </datasources>
          <datasource-dependencies datasource='federated.patients'>
            <column datatype='string' name='[Smoking]' role='dimension' type='nominal' />
            <column datatype='string' name='[ExerciseLevel]' role='dimension' type='nominal' />
            <column datatype='string' name='[Disease]' role='dimension' type='nominal' />
            <column datatype='string' name='[PatientID]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
          </pane>
        </panes>
        <rows>[federated.patients].[none:Smoking:nk]</rows>
        <cols>[federated.patients].[cnt:PatientID:qk]</cols>
      </table>
      <simple-id uuid='worksheet-lifestyle-disease' />
    </worksheet>
    <worksheet name='Symptom_Prevalence'>
      <table>
        <view>
          <datasources>
            <datasource caption='cleaned_patients_data' name='federated.patients' />
          </datasources>
          <datasource-dependencies datasource='federated.patients'>
            <column datatype='string' name='[ChestPain]' role='dimension' type='nominal' />
            <column datatype='string' name='[Fatigue]' role='dimension' type='nominal' />
            <column datatype='string' name='[Dizziness]' role='dimension' type='nominal' />
            <column datatype='string' name='[PatientID]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
          </pane>
        </panes>
        <rows>[federated.patients].[none:ChestPain:nk]</rows>
        <cols>[federated.patients].[cnt:PatientID:qk]</cols>
      </table>
      <simple-id uuid='worksheet-symptoms' />
    </worksheet>
    <worksheet name='High_Risk_Patient_Table'>
      <table>
        <view>
          <datasources>
            <datasource caption='cleaned_patients_data' name='federated.patients' />
          </datasources>
          <datasource-dependencies datasource='federated.patients'>
            <column datatype='string' name='[PatientID]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Age]' role='measure' type='quantitative' />
            <column datatype='string' name='[Gender]' role='dimension' type='nominal' />
            <column datatype='real' name='[BMI]' role='measure' type='quantitative' />
            <column datatype='integer' name='[BloodPressure]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Cholesterol]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Glucose]' role='measure' type='quantitative' />
            <column datatype='string' name='[Disease]' role='dimension' type='nominal' />
            <column datatype='string' name='[HighRisk]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.patients].[none:HighRisk:nk]'>
            <groupfilter function='member' member='&quot;Yes&quot;' />
          </filter>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
          </pane>
        </panes>
        <rows>[federated.patients].[none:PatientID:nk]</rows>
        <cols />
      </table>
      <simple-id uuid='worksheet-highrisk-table' />
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name='1_Clinical_Risk_Dashboard'>
      <style />
      <size maxheight='850' maxwidth='1200' minheight='850' minwidth='1200' type='fixed' />
      <zones>
        <zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='96000' id='2' param='vert' type-v2='layout-flow' w='98000' x='1000' y='2000'>
            <zone h='15000' id='3' name='KPI_Summary' w='98000' x='1000' y='2000' />
            <zone h='40000' id='4' name='Risk_Factor_Heatmap' w='98000' x='1000' y='17000' />
            <zone h='41000' id='5' name='High_Risk_Patient_Table' w='98000' x='1000' y='57000' />
          </zone>
        </zone>
      </zones>
      <simple-id uuid='dash-clinical-risk' />
    </dashboard>
    <dashboard name='2_Lifestyle_Analysis_Dashboard'>
      <style />
      <size maxheight='850' maxwidth='1200' minheight='850' minwidth='1200' type='fixed' />
      <zones>
        <zone h='100000' id='10' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='96000' id='11' param='vert' type-v2='layout-flow' w='98000' x='1000' y='2000'>
            <zone h='48000' id='12' name='Lifestyle_vs_Disease' w='98000' x='1000' y='2000' />
            <zone h='48000' id='13' name='Risk_Factor_Heatmap' w='98000' x='1000' y='50000' />
          </zone>
        </zone>
      </zones>
      <simple-id uuid='dash-lifestyle' />
    </dashboard>
    <dashboard name='3_Population_Health_Dashboard'>
      <style />
      <size maxheight='850' maxwidth='1200' minheight='850' minwidth='1200' type='fixed' />
      <zones>
        <zone h='100000' id='20' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='96000' id='21' param='vert' type-v2='layout-flow' w='98000' x='1000' y='2000'>
            <zone h='32000' id='22' name='Prevalence_by_AgeGroup' w='98000' x='1000' y='2000' />
            <zone h='32000' id='23' name='Prevalence_by_BMICategory' w='98000' x='1000' y='34000' />
            <zone h='32000' id='24' name='Symptom_Prevalence' w='98000' x='1000' y='66000' />
          </zone>
        </zone>
      </zones>
      <simple-id uuid='dash-population-health' />
    </dashboard>
  </dashboards>
  <windows>
    <window class='worksheet' name='KPI_Summary'>
      <cards>
        <edge name='left'>
          <strip size='160'>
            <card type='pages' />
            <card type='filters' />
            <card type='marks' />
          </strip>
        </edge>
      </cards>
    </window>
  </windows>
</workbook>
